VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# Optional. If set, admin image uploads go through the optimizer service first.
VITE_IMAGE_OPTIMIZER_URL=http://localhost:8787

# Optional. Leave empty to let the optimizer service choose its storage driver.
# Use "supabase" only when the optimizer service has Supabase server env vars.
VITE_IMAGE_OPTIMIZER_STORAGE=

# Solo para scripts locales/CI seguros. Nunca exponer en el frontend.
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
