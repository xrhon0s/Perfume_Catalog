VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# Optional. In production this points to the serverless function in this same app.
VITE_IMAGE_OPTIMIZER_URL=/api/optimize-image

# Deprecated. Keep empty. Storage is decided by the serverless function.
VITE_IMAGE_OPTIMIZER_STORAGE=

# Solo para scripts locales/CI seguros. Nunca exponer en el frontend.
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_BUCKET=perfume-images
MAX_UPLOAD_MB=8
DEFAULT_MAX_WIDTH=1200
DEFAULT_WEBP_QUALITY=78
