PORT=8787
HOST=0.0.0.0
NODE_ENV=development

# Optional for private server-to-server use. Do not expose this in a browser.
API_KEY=

# In production, use the exact catalog domain.
CORS_ORIGIN=http://localhost:5173
MAX_UPLOAD_MB=8
DEFAULT_MAX_WIDTH=1200
DEFAULT_WEBP_QUALITY=78

# local | supabase
STORAGE_DRIVER=supabase
ALLOW_STORAGE_OVERRIDE=false
LOCAL_OUTPUT_DIR=public/optimized
PUBLIC_BASE_URL=http://localhost:8787

# Required in production. The service validates the user's Supabase JWT
# against public.admin_users before optimizing uploads.
REQUIRE_SUPABASE_ADMIN=true
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_BUCKET=perfume-images
