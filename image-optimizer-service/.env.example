PORT=8787
HOST=0.0.0.0

# Optional. If set, requests must include x-api-key or Authorization: Bearer.
API_KEY=

CORS_ORIGIN=*
MAX_UPLOAD_MB=8
DEFAULT_MAX_WIDTH=1200
DEFAULT_WEBP_QUALITY=78

# local | supabase
STORAGE_DRIVER=local
LOCAL_OUTPUT_DIR=public/optimized
PUBLIC_BASE_URL=http://localhost:8787

